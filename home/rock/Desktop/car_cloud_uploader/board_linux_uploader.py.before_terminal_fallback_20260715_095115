def append_command_audit(
    *,
    command: dict[str, Any],
    status: str,
    cmd: list[str] | None = None,
    returncode: int | None = None,
    stdout: str = "",
    stderr: str = "",
    message: str = "",
) -> None:
    action = str(command.get("action") or "").strip()
    if action not in {"start_mapping", "stop_mapping", "start_navigation", "start_navigation_route", "update_navigation_goal", "stop_navigation"}:
        return
    payload = {
        "captured_at": iso_from_timestamp(now_s()),
        "command_id": str(command.get("id") or ""),
        "action": action,
        "status": status,
        "cmd": cmd or [],
        "returncode": returncode,
        "message": message,
        "stdout": clip_text(stdout or "", limit=1000),
        "stderr": clip_text(stderr or "", limit=1000),
    }
    try:
        COMMAND_AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with COMMAND_AUDIT_LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")
    except Exception:
        pass


