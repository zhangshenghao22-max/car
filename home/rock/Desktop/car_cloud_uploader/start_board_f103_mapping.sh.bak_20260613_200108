#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME_DIR="${ROOT_DIR}/runtime/cloud_mapping"
LOG_DIR="${RUNTIME_DIR}/logs"
PID_FILE="${RUNTIME_DIR}/mapping.pid"
LOG_FILE="${LOG_DIR}/mapping.log"
MAPPING_MODE="${1:-${CAR_CLOUD_MAPPING_MODE:-frontier}}"
SLAM_BACKEND="${2:-${CAR_CLOUD_SLAM_BACKEND:-toolbox}}"
USE_AUTO_MAPPING="true"

case "${MAPPING_MODE}" in
  frontier|forward)
    ;;
  manual)
    USE_AUTO_MAPPING="false"
    MAPPING_MODE="frontier"
    ;;
  *)
    echo "unsupported mapping mode: ${MAPPING_MODE}; expected frontier, forward, or manual" >&2
    exit 2
    ;;
esac

case "${SLAM_BACKEND}" in
  toolbox|slam_toolbox)
    SLAM_BACKEND="toolbox"
    ;;
  gmapping)
    ;;
  *)
    echo "unsupported slam backend: ${SLAM_BACKEND}; expected toolbox or gmapping" >&2
    exit 2
    ;;
esac

ROS_SETUP="${ROS_SETUP:-/opt/ros/foxy/setup.bash}"
ROS_WS_SETUP="${ROS_WS_SETUP:-${HOME}/Desktop/rock_ws/ros_ws/install/setup.bash}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-17}"
export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-1}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
export PYTHONUNBUFFERED=1

mkdir -p "${LOG_DIR}"

if [[ -s "${PID_FILE}" ]]; then
  PID="$(cat "${PID_FILE}" || true)"
  if [[ -n "${PID}" ]] && kill -0 "${PID}" >/dev/null 2>&1; then
    echo "mapping already running: ${PID}"
    exit 0
  fi
  rm -f "${PID_FILE}"
fi

set +u
source "${ROS_SETUP}"
[[ -f "${ROS_WS_SETUP}" ]] && source "${ROS_WS_SETUP}"
set -u

if [[ -f "${ROOT_DIR}/stop_board_f103_navigation.sh" ]]; then
  CAR_CLOUD_STOP_SILENT=1 bash "${ROOT_DIR}/stop_board_f103_navigation.sh" || true
fi

timeout 2 ros2 topic pub --once /cmd_vel geometry_msgs/msg/Twist \
  "{linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}" >/dev/null 2>&1 || true
timeout 2 ros2 topic pub --once /cmd_vel_cmd geometry_msgs/msg/Twist \
  "{linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}" >/dev/null 2>&1 || true

nohup ros2 launch rt_robot_nav2 rt_robot_nav2_complete.launch.py \
  use_slam:=true \
  use_nav:=false \
  use_chassis_controller:=true \
  use_odom_fusion:=false \
  open_rviz:=false \
  use_auto_mapping:="${USE_AUTO_MAPPING}" \
  auto_mapping_mode:="${MAPPING_MODE}" \
  slam_backend:="${SLAM_BACKEND}" \
  >"${LOG_FILE}" 2>&1 &

PID=$!
echo "${PID}" > "${PID_FILE}"
sleep 2

if ! kill -0 "${PID}" >/dev/null 2>&1; then
  echo "mapping failed to start; log follows:" >&2
  tail -80 "${LOG_FILE}" >&2 || true
  rm -f "${PID_FILE}"
  exit 1
fi

VERIFY_TIMEOUT="${CAR_CLOUD_MAPPING_VERIFY_TIMEOUT:-20}"
if ! [[ "${VERIFY_TIMEOUT}" =~ ^[0-9]+$ ]]; then
  VERIFY_TIMEOUT=20
fi
VERIFY_OK=0
VERIFY_TOPICS=""
VERIFY_NODES=""
for _ in $(seq 1 "${VERIFY_TIMEOUT}"); do
  if ! kill -0 "${PID}" >/dev/null 2>&1; then
    break
  fi
  VERIFY_TOPICS="$(timeout 2 ros2 topic list 2>/dev/null || true)"
  VERIFY_NODES="$(timeout 2 ros2 node list 2>/dev/null || true)"
  HAS_SCAN=0
  HAS_MAP=0
  HAS_SLAM=0
  echo "${VERIFY_TOPICS}" | grep -Eq '^/scan$' && HAS_SCAN=1
  echo "${VERIFY_TOPICS}" | grep -Eq '^/map$' && HAS_MAP=1
  echo "${VERIFY_NODES}" | grep -Eq '(slam_toolbox|slam_gmapping|async_slam_toolbox|sync_slam_toolbox)' && HAS_SLAM=1
  if [[ "${HAS_MAP}" == "1" || ( "${HAS_SCAN}" == "1" && "${HAS_SLAM}" == "1" ) ]]; then
    VERIFY_OK=1
    break
  fi
  sleep 1
done

if [[ "${VERIFY_OK}" != "1" ]]; then
  echo "mapping launch did not expose /map or /scan+SLAM within ${VERIFY_TIMEOUT}s; topics=${VERIFY_TOPICS//$'\n'/, } nodes=${VERIFY_NODES//$'\n'/, }" >&2
  tail -120 "${LOG_FILE}" >&2 || true
  timeout 2 ros2 topic pub --once /cmd_vel geometry_msgs/msg/Twist \
    "{linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}" >/dev/null 2>&1 || true
  timeout 2 ros2 topic pub --once /cmd_vel_cmd geometry_msgs/msg/Twist \
    "{linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}" >/dev/null 2>&1 || true
  kill "${PID}" >/dev/null 2>&1 || true
  CAR_CLOUD_STOP_SILENT=1 bash "${ROOT_DIR}/stop_board_f103_mapping.sh" >/dev/null 2>&1 || true
  rm -f "${PID_FILE}"
  exit 1
fi

echo "mapping started: pid=${PID} domain=${ROS_DOMAIN_ID} mode=${MAPPING_MODE} auto=${USE_AUTO_MAPPING} slam_backend=${SLAM_BACKEND} scan=${HAS_SCAN} map=${HAS_MAP} slam=${HAS_SLAM} log=${LOG_FILE}"
